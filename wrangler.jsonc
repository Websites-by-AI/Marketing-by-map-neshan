{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neshan-m",
  "main": ".open-next/worker.js",
  "account_id": "5b456a2b43bb367410c50b35b9e7f71f",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "neshan-m"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "LEADFAIR_RAG_API": "https://vercel-app-amber-five.vercel.app",
    "LEADFAIR_SEO_URL": "https://master.leadfair.pages.dev/seo-lead"
  },
  "kv_namespaces": [
    {
      "binding": "AGENT_MEMORY",
      "id": "4ea51f7cafaf47efb73a366098015e3d"
    }
  ]
}
