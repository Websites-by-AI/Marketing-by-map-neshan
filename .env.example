# Optional. Without it the app runs fully in demo mode with sample Tehran businesses.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional. Required only for live Neshan Search collection.
# Get a service key from https://platform.neshan.org
NESHAN_API_KEY=

# Optional web SDK key if you later swap Leaflet tiles for official Neshan tiles.
NESHAN_WEB_KEY=

# Cloudflare (local wrangler only — never commit real tokens)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=5b456a2b43bb367410c50b35b9e7f71f
